{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "The privileged QEMU binfmt helper image pinned in action.yml",
      "managerFilePatterns": [
        "/^action\\.yml$/"
      ],
      "matchStrings": [
        "image: (?<depName>docker\\.io/tonistiigi/binfmt):(?<currentValue>qemu-v[\\w.\\-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "The BuildKit driver image pinned in action.yml",
      "managerFilePatterns": [
        "/^action\\.yml$/"
      ],
      "matchStrings": [
        "image=(?<depName>moby/buildkit):(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "extends": [
    "github>meysam81/.github"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Updates to what action.yml runs reach every consumer: commit them as fix so the release tool cuts a patch release (the shared preset commits deps as build, which releases nothing)",
      "matchFileNames": [
        "action.yml"
      ],
      "semanticCommitType": "fix"
    }
  ]
}
